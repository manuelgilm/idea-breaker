# SQLite runtime databases
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Compiled Go binaries and artifacts
/aibreak
/aibreakd
/bin/
*.test
*.out
coverage.*
profile.*

# Go build cache (kept outside repo by default; listed for safety)
vendor/

# Local env / secrets
.env
.env.*

# Editors
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Node (opencode tooling deps)
node_modules/

# GoReleaser output (repo root only)
/dist/

# Wails build output (bin/); build assets (icons, Info.plist, info.json) are
# source and should be committed for custom branding.
/cmd/aibreak-desktop/build/bin/

# Wails generated frontend bindings (regenerated by `wails dev`/`wails build`)
wailsjs/

# Compiled frontend assets (rebuilt by `npm run build`); keep the placeholder
# so `go:embed all:frontend/dist` compiles on a fresh clone.
cmd/aibreak-desktop/frontend/dist/*
!cmd/aibreak-desktop/frontend/dist/.gitkeep
